---
const year = new Date().getFullYear();
---
<footer class="bg-slate-950 text-slate-400 py-16 border-t border-slate-900 mt-auto relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-900">
            <!-- Coluna 1: Sobre & Brand -->
            <div class="space-y-4">
                <div class="flex items-center gap-2">
                    <i class="fas fa-dna text-emerald-500 text-2xl"></i>
                    <span class="text-white font-extrabold tracking-wider text-xl">IAG</span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">
                    <span class="lang-pt">Instituto Agro Genética — Soluções de alta precisão em biologia molecular e análise de solos para o agronegócio.</span>
                    <span class="lang-en">Agro Genetics Institute — High-precision solutions in molecular biology and soil analysis for agribusiness.</span>
                </p>
                <!-- Redes Sociais -->
                <div class="flex items-center gap-3 pt-2">
                    <a href="https://www.instagram.com/institutoagrogenetica/" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-slate-900 hover:bg-pink-600 text-slate-300 hover:text-white flex items-center justify-center transition-all border border-slate-800" title="Instagram @institutoagrogenetica">
                        <i class="fab fa-instagram text-base"></i>
                    </a>
                    <a href="https://wa.me/556221110789" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-slate-900 hover:bg-emerald-600 text-slate-300 hover:text-white flex items-center justify-center transition-all border border-slate-800" title="WhatsApp (62) 2111-0789">
                        <i class="fab fa-whatsapp text-base"></i>
                    </a>
                    <a href="mailto:contato@institutoagrogen.com" class="w-9 h-9 rounded-full bg-slate-900 hover:bg-emerald-600 text-slate-300 hover:text-white flex items-center justify-center transition-all border border-slate-800" title="E-mail contato@institutoagrogen.com">
                        <i class="fas fa-envelope text-sm"></i>
                    </a>
                </div>
            </div>

            <!-- Coluna 2: Links Rápidos -->
            <div>
                <h4 class="text-white text-sm font-bold uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
                    <span class="lang-pt">Navegação</span><span class="lang-en">Navigation</span>
                </h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="/servicos" class="hover:text-emerald-400 transition-colors"><span class="lang-pt">Serviços Biomoleculares</span><span class="lang-en">Biomolecular Services</span></a></li>
                    <li><a href="/solos" class="hover:text-emerald-400 transition-colors"><span class="lang-pt">Análise de Solo</span><span class="lang-en">Soil Analysis</span></a></li>
                    <li><a href="/sobre" class="hover:text-emerald-400 transition-colors"><span class="lang-pt">Quem Somos</span><span class="lang-en">About Us</span></a></li>
                    <li><a href="/blog" class="hover:text-emerald-400 transition-colors"><span class="lang-pt">Blog Técnico</span><span class="lang-en">Technical Blog</span></a></li>
                    <li><a href="/#contato" class="hover:text-emerald-400 transition-colors"><span class="lang-pt">Fale Conosco</span><span class="lang-en">Contact Us</span></a></li>
                </ul>
            </div>

            <!-- Coluna 3: Contatos Diretos -->
            <div>
                <h4 class="text-white text-sm font-bold uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
                    <span class="lang-pt">Atendimento</span><span class="lang-en">Contact</span>
                </h4>
                <ul class="space-y-3 text-xs">
                    <li class="flex items-start gap-2">
                        <i class="fab fa-whatsapp text-emerald-400 text-sm mt-0.5"></i>
                        <div>
                            <span class="block text-slate-300 font-semibold">Telefone / WhatsApp:</span>
                            <a href="https://wa.me/556221110789" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors font-medium">
                                (62) 2111-0789
                            </a>
                        </div>
                    </li>
                    <li class="flex items-start gap-2">
                        <i class="fas fa-envelope text-emerald-400 text-sm mt-0.5"></i>
                        <div>
                            <span class="block text-slate-300 font-semibold">E-mail:</span>
                            <a href="mailto:contato@institutoagrogen.com" class="hover:text-emerald-400 transition-colors">
                                contato@institutoagrogen.com
                            </a>
                        </div>
                    </li>
                    <li class="flex items-start gap-2">
                        <i class="fab fa-instagram text-pink-500 text-sm mt-0.5"></i>
                        <div>
                            <span class="block text-slate-300 font-semibold">Instagram:</span>
                            <a href="https://www.instagram.com/institutoagrogenetica/" target="_blank" rel="noopener noreferrer" class="hover:text-pink-400 transition-colors">
                                @institutoagrogenetica
                            </a>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Coluna 4: Localização -->
            <div>
                <h4 class="text-white text-sm font-bold uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
                    <span class="lang-pt">Laboratório</span><span class="lang-en">Location</span>
                </h4>
                <p class="text-xs leading-relaxed text-slate-400">
                    <i class="fas fa-map-marker-alt text-emerald-400 mr-1"></i>
                    Rua Fortaleza, 1469<br/>
                    Jardim Esmeralda<br/>
                    Aparecida de Goiânia - GO<br/>
                    CEP 74905-180
                </p>
            </div>
        </div>

        <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
            <p class="text-center md:text-left">
                &copy; {year} Instituto Agro Genética. 
                <span class="lang-pt">Todos os direitos reservados.</span>
                <span class="lang-en">All rights reserved.</span>
            </p>
            <div class="flex gap-4">
                <a href="https://institutoagrogen.com" class="hover:text-slate-400 transition-colors">institutoagrogen.com</a>
                <span>|</span>
                <a href="https://institutoagrogenetica.com" class="hover:text-slate-400 transition-colors">institutoagrogenetica.com</a>
            </div>
        </div>
    </div>

    <!-- Botão Flutuante do WhatsApp -->
    <a href="https://wa.me/556221110789" target="_blank" rel="noopener noreferrer" class="fixed bottom-6 right-6 z-50 bg-emerald-500 hover:bg-emerald-400 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-2xl transition-all transform hover:scale-110 group border-2 border-white/20" title="Falar no WhatsApp (62) 2111-0789">
        <i class="fab fa-whatsapp text-3xl"></i>
        <span class="absolute right-16 bg-slate-900 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity border border-slate-800 pointer-events-none">
            (62) 2111-0789
        </span>
    </a>
</footer>

