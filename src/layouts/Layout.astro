---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { title = "IAG - Instituto Agro Genética" } = Astro.props;
---
<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Script executado imediatamente no cabeçalho para evitar o "flash" do idioma incorreto -->
		<script is:inline>
			const savedLang = localStorage.getItem('selected-language') || 'pt-BR';
			document.documentElement.setAttribute('lang', savedLang);
		</script>
	</head>
	<body class="relative min-h-screen flex flex-col text-slate-800 bg-slate-50 overflow-x-hidden">
		<!-- Formas de Fundo -->
		<div class="shape-blob w-96 h-96 top-20 -left-20"></div>
		<div class="shape-blob w-80 h-80 top-1/3 -right-10" style="animation-delay: -2s; background: rgba(15, 23, 42, 0.03);"></div>
		<div class="shape-blob w-full h-96 bottom-0 left-0" style="border-radius: 50% 50% 0 0; background: linear-gradient(180deg, transparent, rgba(6, 78, 59, 0.05)); z-index: -1;"></div>

		<Navbar />
		
		<!-- Conteúdo Principal -->
		<main class="flex-grow pt-20">
			<slot />
		</main>
		
		<Footer />
	</body>
</html>
