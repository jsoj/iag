---
const year = new Date().getFullYear();
---
<footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-900 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-2">
            <i class="fas fa-dna text-emerald-500 text-xl"></i>
            <span class="text-white font-bold tracking-wider text-lg">IAG</span>
            <span class="text-sm text-slate-500 border-l border-slate-800 pl-3 uppercase tracking-widest hidden sm:inline">Instituto Agro Genética</span>
        </div>
        <p class="text-sm text-center md:text-left">
            &copy; {year} Instituto Agro Genética. 
            <span class="lang-pt">Todos os direitos reservados.</span>
            <span class="lang-en">All rights reserved.</span>
        </p>
    </div>
</footer>
